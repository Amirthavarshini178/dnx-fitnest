generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  TRAINER
  ADMIN
}
enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}
enum AttendanceStatus {
  PRESENT
  ABSENT
  HOLIDAY
  GYM_CLOSED
}
enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}
enum PaymentMethod {
  DEMO
  RAZORPAY
  CASH
  UPI
}
enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  ARMS
  LEGS
  CORE
  CARDIO
}
enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
enum TicketCategory {
  GENERAL
  PAYMENT
  MEMBERSHIP
  ATTENDANCE
  TECHNICAL
  TRAINER
  OTHER
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum NoticeType {
  MEMBERSHIP_EXPIRY
  PAYMENT
  WORKOUT
  DIET
  TRAINER_MESSAGE
  ANNOUNCEMENT
  SYSTEM
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  phone         String         @unique
  passwordHash  String
  role          UserRole       @default(MEMBER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       MemberProfile?
  memberships   Membership[]
  payments      Payment[]
  attendance    Attendance[]
  workouts      WorkoutPlan[]
  dietPlans     DietPlan[]
  progress      Progress[]
  notifications Notification[]
  tickets       SupportTicket[]
  @@index([role])
}

model MemberProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  fullName               String
  dateOfBirth            DateTime?
  gender                 String?
  address                String?
  emergencyContactName   String?
  emergencyContactNumber String?
  bloodGroup             String?
  photoUrl               String?
  fitnessGoal            String?
  trainerId              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer                Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  @@index([trainerId])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  paymentId String?          @unique
  plan      String
  status    MembershipStatus @default(PENDING)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment   Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  @@index([userId, status])
  @@index([endDate])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  transactionId String        @unique
  plan          String
  amount        Int
  method        PaymentMethod @default(DEMO)
  status        PaymentStatus @default(PENDING)
  receiptUrl    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership    Membership?
  @@index([userId, createdAt])
  @@index([status])
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  checkIn   DateTime         @default(now())
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, checkIn])
  @@index([status])
}

model WorkoutPlan {
  id        String            @id @default(cuid())
  userId    String
  name      String
  day       String
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  @@index([userId, createdAt])
}

model WorkoutExercise {
  id          String      @id @default(cuid())
  planId      String
  exerciseId  String
  sets        Int
  reps        Int
  restSeconds Int         @default(60)
  completed   Boolean     @default(false)
  completedAt DateTime?
  plan        WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@unique([planId, exerciseId])
  @@index([planId])
}

model Exercise {
  id           String            @id @default(cuid())
  name         String            @unique
  muscle       MuscleGroup
  difficulty   Difficulty        @default(INTERMEDIATE)
  equipment    String
  instructions String
  imageUrl     String?
  createdAt    DateTime          @default(now())
  workoutItems WorkoutExercise[]
  @@index([muscle, difficulty])
}

model DietPlan {
  id        String   @id @default(cuid())
  userId    String
  title     String
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
  meals     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Progress {
  id         String   @id @default(cuid())
  userId     String
  weight     Float
  height     Float?
  bodyFat    Float?
  chest      Float?
  waist      Float?
  arms       Float?
  thighs     Float?
  shoulders  Float?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, recordedAt])
}

model Trainer {
  id              String          @id @default(cuid())
  name            String
  email           String?         @unique
  photoUrl        String?
  bio             String
  experienceYears Int
  specializations String[]
  availability    String?
  createdAt       DateTime        @default(now())
  assignedMembers MemberProfile[]
  @@index([name])
}

model Notification {
  id        String     @id @default(cuid())
  userId    String
  type      NoticeType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  imageUrl    String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  @@index([published, publishedAt])
}

model SupportTicket {
  id            String         @id @default(cuid())
  ticketNumber  String         @unique
  userId        String
  subject       String
  category      TicketCategory
  description   String
  attachmentUrl String?
  status        TicketStatus   @default(OPEN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, createdAt])
}
